{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waitly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
