# URL del backend (waitly-api). Debe incluir el esquema (http:// o https://);
# sin él, fetch la trata como ruta relativa al propio frontend, no como una
# URL absoluta al backend.
# En dev, wrangler expone el worker en :8787.
VITE_API_URL=http://localhost:8787
# En producción, apunta al worker desplegado, por ejemplo:
# VITE_API_URL=https://waitly-api.jorgechavezrnd.workers.dev
